# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string.
# Get this from: Vercel Dashboard → Storage → your Neon DB → .env.local tab
# Or from Neon console: Settings → Connection string (use the pooled URL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random 32-byte hex secret for signing session JWTs.
# Generate with: openssl rand -hex 32
# Must also be set in Vercel env vars (all environments).
AUTH_SECRET=

# Demo login credentials — must also be set in Vercel env vars.
DEMO_USER=benja
DEMO_PASSWORD=turnai2026
